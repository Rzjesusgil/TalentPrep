<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TalentPrep"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#2457A7" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Entrevista completada!"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#202B3C"
            android:gravity="center"
            android:layout_marginTop="35dp" />

        <TextView
            android:id="@+id/tvNombreResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Participante"
            android:textSize="20sp"
            android:textColor="#2457A7"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvCategoriaResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría: Tecnología"
            android:textSize="17sp"
            android:textColor="#202B3C"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Has respondido las 3 preguntas de práctica. Sigue practicando para mejorar tus habilidades."
            android:textSize="17sp"
            android:textColor="#202B3C"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF" />

        <Button
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>
