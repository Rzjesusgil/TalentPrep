<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TP"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="#2457C5"
            android:padding="18dp"
            android:layout_marginTop="35dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TalentPrep"
            android:textColor="#173B78"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prepárate para tu próxima entrevista"
            android:textColor="#52627A"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bienvenido a TalentPrep"
            android:textColor="#202F49"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="45dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Escribe tu nombre para comenzar a practicar."
            android:textColor="#65748B"
            android:textSize="15sp"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Tu nombre"
            android:padding="14dp"
            android:backgroundTint="#2457C5"
            android:inputType="textPersonName"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona tu categoría"
            android:textColor="#202F49"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="22dp"/>

        <Spinner
            android:id="@+id/spCategoria"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#2457C5"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Iniciar entrevista"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#2457C5"
            android:layout_marginTop="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Practica  •  Evalúa  •  Mejora"
            android:textColor="#52627A"
            android:textSize="14sp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"/>

    </LinearLayout>
</ScrollView>
